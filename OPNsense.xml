                class="Processor"
                descr="AMD RX-427BB with AMD Radeon(tm) R7 Graphics"
            />
            <inventory index="196609"
                class="Processor"
                descr="AMD RX-427BB with AMD Radeon(tm) R7 Graphics"
            />
            <inventory index="262145"
                class="Network"
                descr="network interface igb0"
